# ==================== REQUIRED ====================

# Neon PostgreSQL connection string (from Neon dashboard)
# Example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth secret – generate a long random string
# You can use: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-long-random-string"

# Public URL of your deployed app (no trailing slash)
# Example: https://levelock.vercel.app
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==================== EMAIL (Resend) ====================

# Get from https://resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Must be a verified domain/sender in Resend
RESEND_FROM_EMAIL="noreply@yourdomain.com"
RESEND_FROM_NAME="Levelock"

# ==================== IMAGE STORAGE (Cloudinary) ====================

# From Cloudinary Dashboard
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Optional – if using unsigned uploads
# CLOUDINARY_UPLOAD_PRESET="levelock"

# ==================== OPTIONAL ====================

# Unpooled connection (sometimes needed for migrations)
# DATABASE_URL_UNPOOLED="postgresql://..."
